# Task state labels (#185, T-dm8m): the one writer of the `state:` labels.
#
# docs/tasks/task-labels.sh runs docs/tasks/task-state.sh and sets one
# `state:` label on each task issue from its derived state. Nothing else sets
# these labels; a label set by hand is replaced at the next run.
#
# SAFETY, a write token on these triggers. Each trigger runs the workflow file of
# the default branch: `push` to main, `pull_request_target`, `issues`,
# `issue_comment` and `schedule`. `workflow_dispatch`, `create` and `delete` are
# left out on purpose: each can run a branch's own copy of this file, which could
# be edited to use the token (plan review of T-dm8m, condition 5; review of the
# re-plan, condition 1). The checkout names the default branch, so no code of a
# pull request or a branch runs here; no event field (a title, a body, a branch
# name) enters a `run:` step. `docs/tasks/task-labels.sh --check-workflow` holds
# these rules, and its fixtures run in the discipline tests.
#
# Not a required check: no `pull_request` event runs this workflow, so check
# `protection` of docs/setup/setup-check.sh leaves its job out (#201). A failed
# run blocks no merge; the next run sets the labels again.

name: Task state labels

on:
  push:
    branches: [main]
  pull_request_target:
    types: [opened, reopened, closed, edited]
  issues:
    types: [opened, closed, reopened]
  issue_comment:
    types: [created]
  schedule:
    - cron: '*/30 * * * *'

permissions:
  contents: read
  issues: write
  pull-requests: read

concurrency:
  group: task-state-labels
  cancel-in-progress: true

jobs:
  labels:
    name: task-state labels
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      # The checkout of the default branch is the mechanism; this step is what
      # check `ci` (cause `restore`) of setup-check.sh reads, and it restores the
      # scripts from the default branch as every other workflow does.
      - name: Restore the task scripts from the default branch
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: |
          set -eu
          git clone --quiet --depth 1 --branch "$DEFAULT_BRANCH" \
            "https://github.com/${GITHUB_REPOSITORY}.git" .scripts-from-default
          cp -R .scripts-from-default/docs/tasks/. docs/tasks/
          printf 'restored from %s: docs/tasks\n' "$DEFAULT_BRANCH"
      - name: Set the state labels
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: sh docs/tasks/task-labels.sh
